---
// src/components/shared/BtnThemeSwitch.astro
// Tri-state theme toggle: system / light / dark
// Follows the approach recommended by Bramus: store explicit values, never surprise the user
export interface Props {
  className?: string;
  variant?: "primary" | "secondary" | "cta";
}
const { className = "" } = Astro.props;
---

<div
  class={`theme-switch-wrap ${className}`}
  role="group"
  aria-label="Color theme"
>
  <!-- System -->
  <button
    data-theme-btn="system"
    class="btn-theme btn-theme--system"
    aria-label="Use system theme"
    aria-pressed="false"
    title="System"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="2" y="3" width="20" height="14" rx="2"></rect>
      <path d="M8 21h8M12 17v4"></path>
    </svg>
  </button>

  <!-- Light -->
  <button
    data-theme-btn="light"
    class="btn-theme btn-theme--light"
    aria-label="Use light theme"
    aria-pressed="false"
    title="Light"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0z"
      ></path>
    </svg>
  </button>

  <!-- Dark -->
  <button
    data-theme-btn="dark"
    class="btn-theme btn-theme--dark"
    aria-label="Use dark theme"
    aria-pressed="false"
    title="Dark"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998z"
      ></path>
    </svg>
  </button>
</div>

<style>
  .theme-switch-wrap {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    background-color: var(--color-base-200);
    border-radius: 9999px;
    padding: 0.1875rem;
  }

  .dark .theme-switch-wrap {
    background-color: var(--color-base-dark-700);
  }

  .btn-theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    border: none;
    border-radius: 9999px;
    background: transparent;
    color: var(--color-base-dark-200);
    cursor: pointer;
    transition:
      background-color 200ms linear,
      color 200ms linear;
    line-height: 1;
  }

  .dark .btn-theme {
    color: var(--color-base-600);
  }

  .btn-theme svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .btn-theme-label {
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-sans);
  }

  .btn-theme:hover {
    color: var(--color-primary-900);
    background-color: var(--color-base-100);
  }

  .dark .btn-theme:hover {
    color: var(--color-primary-300);
    background-color: var(--color-base-dark-600);
  }

  .btn-theme:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* active state */
  .btn-theme[aria-pressed="true"] {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
  }

  .dark .btn-theme[aria-pressed="true"] {
    background-color: var(--color-primary-700);
    color: var(--color-accent-light);
  }

  /* hide labels on small screens, show on desktop */
  .btn-theme-label {
    display: none;
  }

  @media (min-width: 1024px) {
    .btn-theme-label {
      display: inline;
    }
  }
</style>
