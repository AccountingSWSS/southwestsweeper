---
// src/pages/legal.astro
import Layout from "../layouts/Layout.astro";

const lastUpdated = "May 21, 2026";
---

<Layout title="Legal | Southwest Sweeper Sales">
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Legal</h1>
        <p class="last-updated">
          Last updated: <time datetime="2026-05-21">{lastUpdated}</time>
        </p>
      </div>
    </section>

    <section class="page-body" aria-label="Legal information">
      <div class="container container--narrow">
        <article class="prose">
          <section aria-labelledby="terms-heading">
            <h2 id="terms-heading">Terms of Use</h2>
            <p>
              By accessing and using the Southwest Sweeper Sales website, you
              accept and agree to be bound by these terms. If you do not agree
              to these terms, please do not use this site.
            </p>
          </section>

          <section aria-labelledby="ip-heading">
            <h2 id="ip-heading">Intellectual Property</h2>
            <p>
              All content on this site — including text, images, logos, and
              graphics — is the property of Southwest Sweeper Sales and is
              protected by applicable copyright and trademark laws. Unauthorized
              use is prohibited.
            </p>
          </section>

          <section aria-labelledby="liability-heading">
            <h2 id="liability-heading">Limitation of Liability</h2>
            <p>
              Southwest Sweeper Sales makes no warranties, expressed or implied,
              regarding the accuracy or completeness of information on this
              site. We are not liable for any damages arising from your use of
              this website or its content.
            </p>
          </section>

          <section aria-labelledby="links-heading">
            <h2 id="links-heading">Third-Party Links</h2>
            <p>
              This site may contain links to third-party websites. These links
              are provided for convenience only. Southwest Sweeper Sales has no
              control over the content of those sites and accepts no
              responsibility for them.
            </p>
          </section>

          <section aria-labelledby="changes-heading">
            <h2 id="changes-heading">Changes to This Page</h2>
            <p>
              We reserve the right to update this page at any time. Continued
              use of the site after changes are posted constitutes your
              acceptance of the revised terms.
            </p>
          </section>

          <section aria-labelledby="contact-heading">
            <h2 id="contact-heading">Contact</h2>
            <p>
              For legal inquiries, please contact us at
              <a href="mailto:legal@southwestsweepersales.com"
                >legal@southwestsweepersales.com</a
              >.
            </p>
          </section>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .last-updated {
    font-size: 0.9375rem;
    color: var(--color-primary-200);
    margin: 0;
  }

  .page-body {
    padding: 4rem 0;
    background-color: var(--bg-body);
  }

  /* prose — section spacing and typography */
  .prose {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .prose section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-body);
    border-bottom: 2px solid var(--color-primary-200);
    padding-bottom: 0.5rem;
    margin: 0;
  }

  .dark .prose h2 {
    border-bottom-color: var(--color-primary-800);
  }

  .prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-base-dark-300);
    margin: 0;
  }

  .dark .prose p {
    color: var(--color-base-400);
  }

  .prose a {
    color: var(--color-primary-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .dark .prose a {
    color: var(--color-primary-400);
  }

  .prose a:hover {
    color: var(--color-primary-900);
  }

  .dark .prose a:hover {
    color: var(--color-primary-300);
  }

  .prose a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
