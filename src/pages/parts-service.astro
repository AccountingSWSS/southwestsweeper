---
// src/pages/parts-service.astro
import Layout from "../layouts/Layout.astro";
import { contentfulClient } from "../lib/contentful";
import type { PartsServiceBrand } from "../types/contentful";

let brands: {
  name: string;
  description: string;
  logo: string | null;
  sortOrder: number;
}[] = [];

try {
  const entries = await contentfulClient.getEntries<PartsServiceBrand>({
    content_type: "partsServiceBrand",
    order: ["fields.sortOrder"] as any,
  });

  brands = entries.items.map((item) => ({
    name: item.fields.name as string,
    description: item.fields.description as string,
    logo: (item.fields.logo as any)?.fields?.file?.url
      ? `https:${(item.fields.logo as any).fields.file.url}`
      : null,
    sortOrder: item.fields.sortOrder as number,
  }));
} catch (e) {
  console.error("Failed to fetch partsServiceBrand entries:", e);
}
---

<Layout title="Parts & Service | Southwest Sweeper Sales">
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Parts &amp; Service</h1>
        <p class="lead">
          We stock a full range of sweeper parts for the machines we sell and
          service.
        </p>
        <p class="lead-accent">
          Order for pickup. Supporting all major brands.
        </p>
      </div>
    </section>

    <section class="parts-list" aria-labelledby="parts-heading">
      <div class="container container--medium">
        <h2 id="parts-heading" class="sr-only">Parts and service brands</h2>

        {
          brands.length > 0 ? (
            <ul class="parts-items" role="list">
              {brands.map((brand) => (
                <li class="parts-item">
                  {brand.logo && (
                    <div class="parts-image">
                      <img
                        src={brand.logo}
                        alt=""
                        aria-hidden="true"
                        loading="lazy"
                        decoding="async"
                        width="300"
                        height="200"
                      />
                    </div>
                  )}
                  <div class="parts-body">
                    <h3 class="parts-title">{brand.name}</h3>
                    <p class="parts-desc">{brand.description}</p>
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="parts-empty">
              Parts and service information coming soon. Call us at
              <a href="tel:6026780496">(602) 678-0496</a> for current
              availability.
            </p>
          )
        }
      </div>
    </section>

    <section class="parts-cta" aria-label="Contact us about parts and service">
      <div class="container container--medium">
        <p class="cta-text">
          Explore Southwest Sweeper Sales parts and service departments.
        </p>
        <p class="cta-phone">
          <a href="tel:6026780496">(602) 678-0496</a>
          <span class="cta-hours">Monday - Friday: 7:00am - 4:00pm</span>
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-primary-200);
    max-width: 52ch;
    margin: 0 0 0.25rem;
    line-height: 1.6;
  }

  .lead-accent {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-cta);
    max-width: 52ch;
    margin: 0;
    line-height: 1.6;
  }

  .parts-list {
    padding: 4rem 0 6rem;
    background-color: var(--bg-body);
  }

  .parts-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .parts-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .parts-items {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .parts-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background-color: var(--bg-card);
    border: 3px solid var(--color-base-dark-500);
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .dark .parts-item {
    border-color: var(--color-base-dark-700);
  }

  .parts-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
  }

  .parts-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .parts-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .parts-body--full {
    grid-column: 1 / -1;
  }

  .parts-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-body);
    margin: 0;
  }

  .parts-desc {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-base-dark-50);
    margin: 0;
  }

  .dark .parts-desc {
    color: var(--color-base-100);
  }

  .parts-empty {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-base-dark-50);
  }

  .dark .parts-empty {
    color: var(--color-base-100);
  }

  .parts-empty a {
    color: var(--color-primary-700);
    text-decoration: underline;
  }

  .dark .parts-empty a {
    color: var(--color-primary-400);
  }

  .parts-cta {
    padding: 4rem 0;
    background-color: var(--color-primary-50);
    border-top: 1px solid var(--color-primary-200);
  }

  :global(.dark) .parts-cta {
    background-color: var(--color-base-dark-900);
    border-top-color: var(--color-primary-900);
  }

  .cta-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-body);
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }

  :global(.dark) .cta-text {
    color: var(--color-accent-light);
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-cta {
    display: inline-block;
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 300ms linear;
  }

  .btn-cta:hover {
    background-color: var(--color-primary-800);
  }

  .btn-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-outline {
    display: inline-block;
    background-color: transparent;
    color: var(--color-primary-700);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-primary-700);
    text-decoration: none;
    transition:
      background-color 300ms linear,
      color 300ms linear;
  }

  .btn-outline:hover {
    background-color: var(--color-primary-700);
    color: var(--color-accent-light);
  }

  .btn-outline:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .dark .btn-outline {
    color: var(--color-primary-300);
    border-color: var(--color-primary-300);
  }

  .dark .btn-outline:hover {
    background-color: var(--color-primary-800);
    color: var(--color-accent-light);
    border-color: var(--color-primary-800);
  }
</style>
