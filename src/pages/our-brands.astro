---
import Layout from "../layouts/Layout.astro";
import LazyImage from "../components/shared/LazyImage.astro";
import Container from "../components/shared/Container.astro";
import { partsServiceSection } from "../components/sections/parts-service/data.ts";

const brands = partsServiceSection.partsService.slice(1);
---

<Layout title="Our Brands | Southwest Sweeper Sales">
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Our Brands</h1>
        <p class="lead">
          Browse the brands and equipment we sell and service. Contact our sales
          team for current availability and pricing.
        </p>
      </div>
    </section>

    <section class="equipment-section" aria-labelledby="equipment-heading">
      <Container>
        <h2 id="equipment-heading" class="sr-only">Equipment brands</h2>
        {
          brands.map((brand, index) => (
            <div class="alternating-section-item">
              <div
                class={`alternating-row ${index % 2 === 0 ? "alternating-row--reverse" : ""}`}
              >
                <div class="alternating-image-col">
                  <div class="alternating-image-wrap">
                    <LazyImage
                      src={brand.visual}
                      alt={brand.title}
                      width="500"
                      class="rounded-3xl object-cover h-full"
                    />
                  </div>
                </div>
                <div class="alternating-text-col">
                  <h3 class="brand-title">{brand.title}</h3>
                  <p class="brand-desc">{brand.description}</p>
                </div>
              </div>
            </div>
          ))
        }
      </Container>
    </section>

    <section class="equipment-cta" aria-label="Contact us about equipment">
      <div class="container container--medium">
        <p class="cta-text">
          Looking for specific equipment? Our sales team can help.
        </p>
        <p class="cta-phone">
          Give us a call at (602) 678-0496 / Monday - Friday: 7:00am - 4:00pm
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* --- hero --- */
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-primary-200);
    max-width: 52ch;
    margin: 0;
    line-height: 1.6;
  }

  /* --- section --- */
  .equipment-section {
    padding: 4rem 0 6rem;
    background-color: var(--bg-body);
  }

  /* --- brand list --- */
  .brand-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .brand-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  .brand-image {
    width: 100%;
    border-radius: 1rem;
    overflow: hidden;
    max-height: 320px;
  }

  .brand-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .brand-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .brand-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--text-body);
  }

  .brand-desc {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-base-dark-300);
  }

  :global(.dark) .brand-desc {
    color: var(--color-base-100);
  }
  @media (min-width: 768px) {
    .brand-item {
      grid-template-columns: 1fr 1fr;
    }

    .brand-image {
      max-height: none;
      height: 100%;
    }

    .brand-item--reverse .brand-image {
      order: 2;
    }

    .brand-item--reverse .brand-body {
      order: 1;
    }
  }

  /* --- cta --- */
  .equipment-cta {
    padding: 4rem 0;
    background-color: var(--color-primary-50);
    border-top: 1px solid var(--color-primary-200);
  }

  :global(.dark) .equipment-cta {
    background-color: var(--color-base-dark-900);
    border-top-color: var(--color-primary-900);
  }

  .cta-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-body);
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }

  :global(.dark) .cta-text {
    color: var(--color-accent-light);
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-cta {
    display: inline-block;
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 300ms linear;
  }

  .btn-cta:hover {
    background-color: var(--color-primary-800);
  }

  .btn-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-outline {
    display: inline-block;
    background-color: transparent;
    color: var(--color-primary-700);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-primary-700);
    text-decoration: none;
    transition:
      background-color 300ms linear,
      color 300ms linear;
  }

  .btn-outline:hover {
    background-color: var(--color-primary-700);
    color: var(--color-accent-light);
  }

  .btn-outline:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .dark .btn-outline {
    color: var(--color-primary-300);
    border-color: var(--color-primary-300);
  }

  .dark .btn-outline:hover {
    background-color: var(--color-primary-800);
    color: var(--color-accent-light);
    border-color: var(--color-primary-800);
  }
</style>
