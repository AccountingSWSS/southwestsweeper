---
// src/pages/sales/contact.astro
// Sales contact methods — phone, email, office address
import Layout from "../../layouts/Layout.astro";

const title = "Contact Sales | Southwest Sweeper Sales";

const contacts = [
  {
    method: "Phone",
    value: "+1 (555) 000-0000",
    href: "tel:+15550000000",
    detail: "Monday - Friday, 7:00 AM - 5:00 PM MST",
    icon: "phone",
  },
  {
    method: "Email",
    value: "sales@southwestsweepersales.com",
    href: "mailto:sales@southwestsweepersales.com",
    detail: "We respond within one business day.",
    icon: "email",
  },
  {
    method: "Visit Us",
    value: "123 Desert Commerce Blvd, Phoenix, AZ 85001",
    href: "https://maps.google.com/?q=123+Desert+Commerce+Blvd+Phoenix+AZ+85001",
    detail: "Monday - Friday, 7:00 AM - 5:00 PM MST",
    icon: "location",
  },
];
---

<Layout title={title}>
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Contact Sales</h1>
        <p class="lead">
          Ready to talk equipment? Our sales team is here to help you find the
          right sweeper solution for your operation.
        </p>
      </div>
    </section>

    <section class="contact-methods" aria-labelledby="methods-heading">
      <div class="container container--medium">
        <h2 id="methods-heading" class="sr-only">Ways to reach us</h2>

        <ul class="contact-list" role="list">
          {
            contacts.map((c) => (
              <li class="contact-card">
                <div class="contact-icon" aria-hidden="true">
                  {c.icon === "phone" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.11 12 19.79 19.79 0 0 1 1.05 3.35 2 2 0 0 1 3 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 5.93 5.93l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                    </svg>
                  )}
                  {c.icon === "email" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <rect x="2" y="4" width="20" height="16" rx="2" />
                      <path d="m2 7 10 7 10-7" />
                    </svg>
                  )}
                  {c.icon === "location" && (
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" />
                      <circle cx="12" cy="9" r="2.5" />
                    </svg>
                  )}
                </div>

                <div class="contact-body">
                  <h3 class="contact-method">{c.method}</h3>
                  <a
                    class="contact-value"
                    href={c.href}
                    rel={
                      c.icon === "location" ? "noopener noreferrer" : undefined
                    }
                    target={c.icon === "location" ? "_blank" : undefined}
                  >
                    {c.value}
                    {c.icon === "location" && (
                      <span class="sr-only">
                        {" "}
                        (opens Google Maps in a new tab)
                      </span>
                    )}
                  </a>
                  <p class="contact-detail">{c.detail}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="inquiry-cta">
          <p>Prefer to send us details in writing?</p>
          <a href="/sales/inquiry/" class="btn-primary">Submit a Sales Inquiry</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* --- hero --- */
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-primary-200);
    max-width: 52ch;
    margin: 0;
    line-height: 1.6;
  }

  /* --- section --- */
  .contact-methods {
    padding: 4rem 0;
    background-color: var(--bg-body);
  }

  /* --- contact list --- */
  .contact-list {
    list-style: none;
    margin: 0 0 4rem;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .contact-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background-color: var(--bg-card);
    border: 1px solid var(--color-base-200);
    border-radius: 0.5rem;
    padding: 1.5rem 2.5rem;
    box-shadow: var(--shadow-lg);
  }

  .dark .contact-card {
    border-color: var(--color-base-dark-700);
  }

  .contact-icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--color-primary);
    margin-top: 0.125rem;
  }

  .contact-icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-method {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-base-dark-50);
    margin: 0;
  }

  .dark .contact-method {
    color: var(--color-base-500);
  }

  .contact-value {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-primary-700);
    text-decoration: none;
    word-break: break-word;
  }

  .dark .contact-value {
    color: var(--color-primary-400);
  }

  .contact-value:hover,
  .contact-value:focus-visible {
    color: var(--color-primary-900);
    text-decoration: underline;
  }

  .dark .contact-value:hover,
  .dark .contact-value:focus-visible {
    color: var(--color-primary-300);
  }

  .contact-value:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .contact-detail {
    font-size: 0.9375rem;
    color: var(--color-base-dark-50);
    margin: 0;
  }

  .dark .contact-detail {
    color: var(--color-base-500);
  }

  /* --- inquiry CTA --- */
  .inquiry-cta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-base-200);
    padding-top: 2.5rem;
  }

  .dark .inquiry-cta {
    border-top-color: var(--color-base-dark-700);
  }

  .inquiry-cta p {
    margin: 0;
    color: var(--color-base-dark-50);
  }

  .dark .inquiry-cta p {
    color: var(--color-base-500);
  }

  .btn-primary {
    display: inline-block;
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 300ms linear;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-800);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* --- responsive --- */
  @media (max-width: 600px) {
    .contact-card {
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem;
    }

    .inquiry-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
