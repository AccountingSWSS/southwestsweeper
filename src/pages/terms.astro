---
// src/pages/terms.astro
import Layout from "../layouts/Layout.astro";

const lastUpdated = "May 21, 2026";
---

<Layout title="Terms & Conditions | Southwest Sweeper Sales">
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Terms &amp; Conditions</h1>
        <p class="last-updated">
          Last updated: <time datetime="2026-05-21">{lastUpdated}</time>
        </p>
      </div>
    </section>

    <section class="page-body" aria-label="Terms and conditions">
      <div class="container container--narrow">
        <article class="prose">
          <section aria-labelledby="acceptance-heading">
            <h2 id="acceptance-heading">Acceptance of Terms</h2>
            <p>
              By using this website, you confirm that you are at least 18 years
              of age and agree to be bound by these Terms &amp; Conditions. If
              you do not agree, please discontinue use of this site immediately.
            </p>
          </section>

          <section aria-labelledby="services-heading">
            <h2 id="services-heading">Products and Services</h2>
            <p>
              Southwest Sweeper Sales provides information about sweeping
              equipment, rentals, parts, and related services. Availability,
              pricing, and specifications are subject to change without notice.
              All sales are subject to a separate sales agreement.
            </p>
          </section>

          <section aria-labelledby="accuracy-heading">
            <h2 id="accuracy-heading">Accuracy of Information</h2>
            <p>
              We strive to keep product information, pricing, and availability
              accurate. However, errors may occur. Southwest Sweeper Sales
              reserves the right to correct any errors and to cancel orders or
              inquiries placed based on inaccurate information.
            </p>
          </section>

          <section aria-labelledby="prohibited-heading">
            <h2 id="prohibited-heading">Prohibited Use</h2>
            <p>
              You agree not to use this site for any unlawful purpose, to submit
              false or misleading information, to attempt unauthorized access to
              any part of the site, or to interfere with the proper functioning
              of the site in any way.
            </p>
          </section>

          <section aria-labelledby="disclaimer-heading">
            <h2 id="disclaimer-heading">Disclaimer of Warranties</h2>
            <p>
              This site and its content are provided "as is" without warranty of
              any kind, either expressed or implied. Southwest Sweeper Sales
              does not warrant that the site will be uninterrupted, error-free,
              or free of viruses or other harmful components.
            </p>
          </section>

          <section aria-labelledby="governing-heading">
            <h2 id="governing-heading">Governing Law</h2>
            <p>
              These terms are governed by the laws of the State of Arizona. Any
              disputes arising from your use of this site shall be resolved in
              the courts of Maricopa County, Arizona.
            </p>
          </section>

          <section aria-labelledby="updates-heading">
            <h2 id="updates-heading">Updates to These Terms</h2>
            <p>
              Southwest Sweeper Sales may revise these terms at any time. The
              most current version will always be posted on this page with an
              updated date. Continued use of the site constitutes acceptance of
              any changes.
            </p>
          </section>

          <section aria-labelledby="terms-contact-heading">
            <h2 id="terms-contact-heading">Contact</h2>
            <p>
              Questions about these terms can be directed to
              <a href="mailto:legal@southwestsweepersales.com"
                >legal@southwestsweepersales.com</a
              >.
            </p>
          </section>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }

  .last-updated {
    font-size: 0.9375rem;
    color: var(--color-primary-200);
    margin: 0;
  }

  .page-body {
    padding: 4rem 0;
    background-color: var(--bg-body);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .prose section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .prose h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-body);
    border-bottom: 2px solid var(--color-primary-200);
    padding-bottom: 0.5rem;
    margin: 0;
  }

  .dark .prose h2 {
    border-bottom-color: var(--color-primary-800);
  }

  .prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-base-dark-300);
    margin: 0;
  }

  .dark .prose p {
    color: var(--color-base-400);
  }

  .prose a {
    color: var(--color-primary-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .dark .prose a {
    color: var(--color-primary-400);
  }

  .prose a:hover {
    color: var(--color-primary-900);
  }

  .dark .prose a:hover {
    color: var(--color-primary-300);
  }

  .prose a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
