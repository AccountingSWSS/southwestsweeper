---
// src/pages/equipment.astro
// Placeholder — content and categories to be added when ready
import Layout from "../layouts/Layout.astro";

const categories = [
  {
    id: "street-sweepers",
    title: "Street Sweepers",
    items: [
      {
        name: "Placeholder Model",
        description: "Equipment details coming soon.",
      },
    ],
  },
  {
    id: "parking-lot-sweepers",
    title: "Parking Lot Sweepers",
    items: [
      {
        name: "Placeholder Model",
        description: "Equipment details coming soon.",
      },
    ],
  },
  {
    id: "industrial-sweepers",
    title: "Industrial Sweepers & Scrubbers",
    items: [
      {
        name: "Placeholder Model",
        description: "Equipment details coming soon.",
      },
    ],
  },
  {
    id: "specialty-equipment",
    title: "Specialty Equipment",
    items: [
      {
        name: "Placeholder Model",
        description: "Equipment details coming soon.",
      },
    ],
  },
];
---

<Layout title="Equipment | Southwest Sweeper Sales">
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Equipment</h1>
        <p class="lead">
          Browse our full range of sweeping and scrubbing equipment. New
          listings coming soon — contact our sales team for current
          availability.
        </p>
      </div>
    </section>

    <section class="equipment-section" aria-labelledby="equipment-heading">
      <div class="container container--medium">
        <h2 id="equipment-heading" class="sr-only">Equipment categories</h2>

        <nav class="category-nav" aria-label="Jump to category">
          {
            categories.map((cat) => (
              <a href={`#${cat.id}`} class="category-pill">
                {cat.title}
              </a>
            ))
          }
        </nav>

        <div class="categories">
          {
            categories.map((cat) => (
              <div id={cat.id} class="category">
                <h3 class="category-title">{cat.title}</h3>
                <ul class="equipment-list" role="list">
                  {cat.items.map((item) => (
                    <li class="equipment-card">
                      <div class="equipment-image" aria-hidden="true">
                        <div class="image-placeholder" />
                      </div>
                      <div class="equipment-body">
                        <h4 class="equipment-name">{item.name}</h4>
                        <p class="equipment-desc">{item.description}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="equipment-cta" aria-label="Contact us about equipment">
      <div class="container container--medium">
        <p class="cta-text">
          Looking for specific equipment? Our sales team can help.
        </p>
        <div class="cta-actions">
          <a href="/sales/contact" class="btn-cta">Contact Sales</a>
          <a href="/sales/inquiry" class="btn-outline">Submit an Inquiry</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* --- hero --- */
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-primary-200);
    max-width: 52ch;
    margin: 0;
    line-height: 1.6;
  }

  /* --- section --- */
  .equipment-section {
    padding: 4rem 0;
    background-color: var(--bg-body);
  }

  /* --- category jump nav --- */
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .category-pill {
    display: inline-block;
    background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
    border: 1px solid var(--color-primary);
    color: var(--color-primary-800);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    text-decoration: none;
    transition:
      background-color 300ms linear,
      color 300ms linear;
  }

  .dark .category-pill {
    color: var(--color-primary-300);
  }

  .category-pill:hover {
    background-color: var(--color-primary);
    color: var(--color-accent-light);
  }

  .category-pill:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* --- categories --- */
  .categories {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .category {
    scroll-margin-top: 6rem;
  }

  .category-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-body);
    margin: 0 0 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-primary-200);
  }

  .dark .category-title {
    border-bottom-color: var(--color-primary-600);
  }

  /* --- equipment list --- */
  .equipment-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .equipment-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .equipment-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- equipment card --- */
  .equipment-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card);
    border: 1px solid var(--color-base-200);
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .dark .equipment-card {
    border-color: var(--color-base-dark-700);
  }

  .equipment-image {
    width: 100%;
    height: 180px;
    background-color: var(--color-base-200);
  }

  .dark .equipment-image {
    background-color: var(--color-base-dark-600);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 10px,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 20px
    );
  }

  .dark .image-placeholder {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 10px,
      color-mix(in srgb, var(--color-primary) 15%, transparent) 20px
    );
  }

  .equipment-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .equipment-name {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-body);
    margin: 0;
  }

  .equipment-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-body);
    margin: 0;
  }

  .dark .equipment-desc {
    color: var(--color-base-100);
  }

  /* --- cta --- */
  .equipment-cta {
    padding: 4rem 0;
    background-color: var(--color-primary-50);
    border-top: 1px solid var(--color-primary-200);
  }

  :global(.dark) .equipment-cta {
    background-color: var(--color-base-dark-900);
    border-top-color: var(--color-primary-900);
  }

  .cta-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-body);
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }

  :global(.dark) .cta-text {
    color: var(--color-accent-light);
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-cta {
    display: inline-block;
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 300ms linear;
  }

  .btn-cta:hover {
    background-color: var(--color-primary-800);
  }

  .btn-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-outline {
    display: inline-block;
    background-color: transparent;
    color: var(--color-primary-300);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-primary-300);
    text-decoration: none;
    transition:
      background-color 300ms linear,
      color 300ms linear;
  }

  .btn-outline:hover {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
  }

  .btn-outline:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .dark .btn-outline {
    color: var(--color-primary-300);
    border-color: var(--color-primary-300);
  }

  .dark .btn-outline:hover {
    background-color: var(--color-primary-800);
    color: var(--color-accent-light);
    border-color: var(--color-primary-800);
  }
</style>
