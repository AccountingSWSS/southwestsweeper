---
// src/pages/facility-services.astro
import Layout from "../layouts/Layout.astro";
import { servicesSectionData } from "../components/sections/facility-services/data";
---

<Layout title="Facility Services | Southwest Sweeper Sales">
  <main id="main-content">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="container container--medium">
        <h1 id="page-heading">Facility Services</h1>
        <p class="lead">
          {servicesSectionData.subheading.text1_1}{
            servicesSectionData.subheading.text1_2
          }
        </p>
      </div>
    </section>

    <section class="services-intro" aria-label="About our facility services">
      <div class="container container--medium">
        <p class="intro-text">{servicesSectionData.subheading.text2}</p>
      </div>
    </section>

    <section class="services-list" aria-labelledby="services-heading">
      <div class="container container--medium">
        <h2 id="services-heading" class="sr-only">Our services</h2>
        <ul class="service-items" role="list">
          {
            servicesSectionData.services.map((service) => (
              <li class="service-item">
                <div class="service-image">
                  <img
                    src={service.visual.src}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    width="480"
                    height="320"
                  />
                </div>
                <div class="service-body">
                  <h3 class="service-title">{service.title}</h3>
                  <p class="service-desc">{service.briefDescription}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      class="services-cta"
      aria-label="Contact us about facility services"
    >
      <div class="container container--medium">
        <p class="cta-text">Ready to get started? Contact our team today.</p>
      </div>
      <p class="cta-phone">
        Give us a call at (602) 678-0496 / Monday - Friday: 7:00am - 4:00pm
      </p>
    </section>
  </main>
</Layout>

<style>
  /* --- hero --- */
  .page-hero {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    padding: 4rem 0;
  }

  .page-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.1;
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-primary-200);
    max-width: 52ch;
    margin: 0;
    line-height: 1.6;
  }

  /* --- intro --- */
  .services-intro {
    padding: 3rem 0 0;
    background-color: var(--bg-body);
  }

  .intro-text {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--color-base-dark-300);
    max-width: 68ch;
  }

  .dark .intro-text {
    color: var(--color-base-400);
  }

  /* --- service list --- */
  .services-list {
    padding: 3rem 0;
    background-color: var(--bg-body);
  }

  .service-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .service-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--color-base-200);
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .dark .service-item {
    border-color: var(--color-base-dark-700);
  }

  .service-image {
    width: 100%;
    max-height: 280px;
    overflow: hidden;
  }

  .service-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .service-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-body);
    margin: 0;
  }

  .service-desc {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-base-dark-50);
    margin: 0;
  }

  .dark .service-desc {
    color: var(--color-base-100);
  }

  .intro-text {
    color: var(--color-base-dark-50);
  }

  .dark .intro-text {
    color: var(--color-base-100);
  }

  /* --- two-column layout on wider screens --- */
  @media (min-width: 640px) {
    .service-item {
      grid-template-columns: 280px 1fr;
    }

    .service-image {
      max-height: none;
      height: 100%;
    }
  }

  /* --- cta --- */
  .services-cta {
    padding: 4rem 0;
    background-color: var(--color-primary-50);
    border-top: 1px solid var(--color-primary-200);
  }

  :global(.dark) .services-cta {
    background-color: var(--color-base-dark-900);
    border-top-color: var(--color-primary-900);
  }

  .cta-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-body);
    margin: 0 0 1.5rem;
  }

  :global(.dark) .cta-text {
    color: var(--color-accent-light);
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-cta {
    display: inline-block;
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 300ms linear;
  }

  .btn-cta:hover {
    background-color: var(--color-primary-800);
  }

  .btn-cta:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .btn-outline {
    display: inline-block;
    background-color: transparent;
    color: var(--color-primary-300);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.75rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-primary-300);
    text-decoration: none;
    transition:
      background-color 300ms linear,
      color 300ms linear;
  }

  .btn-outline:hover {
    background-color: var(--color-primary-900);
    color: var(--color-accent-light);
  }

  .btn-outline:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .dark .btn-outline {
    color: var(--color-primary-300);
    border-color: var(--color-primary-300);
  }

  .dark .btn-outline:hover {
    background-color: var(--color-primary-800);
    color: var(--color-accent-light);
    border-color: var(--color-primary-800);
  }
</style>
