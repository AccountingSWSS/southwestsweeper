---
// src/layouts/Layout.astro
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import BackToTop from "../components/shared/BackToTop.astro";

export interface Props {
  title: string;
  description?: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Southwest Sweeper Sales" />
    <title>Southwest Sweeper Sales - {title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style/custom.css" />

    <!-- Apply theme before paint to avoid flash -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        var isDark =
          stored === "dark" ||
          (!stored && prefersDark) ||
          (stored === "system" && prefersDark);
        if (isDark) document.documentElement.classList.add("dark");
        else document.documentElement.classList.remove("dark");
      })();
    </script>
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
    <BackToTop />
  </body>

  <script>
    // Tri-state theme: system | light | dark
    // Stores explicit values — never surprises user when OS switches at night

    type Theme = "system" | "light" | "dark";

    function getStoredTheme(): Theme {
      const t = localStorage.getItem("theme") as Theme | null;
      return t === "light" || t === "dark" ? t : "system";
    }

    function applyTheme(theme: Theme) {
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const isDark = theme === "dark" || (theme === "system" && prefersDark);
      document.documentElement.classList.toggle("dark", isDark);
    }

    function setTheme(theme: Theme) {
      if (theme === "system") {
        localStorage.removeItem("theme");
      } else {
        localStorage.setItem("theme", theme);
      }
      applyTheme(theme);
      updateButtons(theme);
    }

    function updateButtons(theme: Theme) {
      document
        .querySelectorAll<HTMLButtonElement>("[data-theme-btn]")
        .forEach((btn) => {
          const isActive = btn.dataset.themeBtn === theme;
          btn.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
    }

    // Init
    const current = getStoredTheme();
    applyTheme(current);
    updateButtons(current);

    // Wire up buttons
    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-btn]")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const theme = btn.dataset.themeBtn as Theme;
          setTheme(theme);
        });
      });

    // Respond to OS changes when in system mode
    window
      .matchMedia("(prefers-color-scheme: dark)")
      .addEventListener("change", () => {
        if (getStoredTheme() === "system") {
          applyTheme("system");
        }
      });
  </script>

  <script>
    // Nav toggle — saves scroll position to prevent layout shift on close
    const toggleMenu = document.querySelector(
      "[data-toggle-nav]",
    ) as HTMLButtonElement;
    const navbar = document.querySelector("[data-navbar]") as HTMLDivElement;
    const overlayNav = document.querySelector(
      "[data-nav-overlay]",
    ) as HTMLDivElement;

    let scrollY = 0;

    function openNav() {
      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.documentElement.style.setProperty(
        "--scrollbar-width",
        `${scrollbarWidth}px`,
      );
      scrollY = window.scrollY;
      document.body.style.top = `-${scrollY}px`;
      toggleMenu.setAttribute("data-open-nav", "true");
      overlayNav.setAttribute("data-is-visible", "true");
      document.body.classList.add("nav-open");
      navbar.style.height = `${navbar.scrollHeight}px`;
    }

    function closeNav() {
      toggleMenu.setAttribute("data-open-nav", "false");
      overlayNav.setAttribute("data-is-visible", "false");
      document.body.classList.remove("nav-open");
      document.body.style.top = "";
      window.scrollTo(0, scrollY);
      navbar.style.height = "0px";
    }

    if (toggleMenu) {
      toggleMenu.addEventListener("click", (e) => {
        e.preventDefault();
        if (toggleMenu.getAttribute("data-open-nav") === "false") {
          openNav();
        } else {
          closeNav();
        }
      });

      navbar.addEventListener("click", () => closeNav());
      overlayNav.addEventListener("click", () => closeNav());
    }
  </script>
</html>
