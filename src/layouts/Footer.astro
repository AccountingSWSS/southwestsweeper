---
import GroupFooterNav from "../components/blocks/GroupFooterNav.astro";
import Container from "../components/shared/Container.astro";
import FooterNav from "../components/shared/FooterNav.astro";

const footerNav1 = [
  { itemText: "Facility Services", itemLink: "/facility-services" },
  { itemText: "Rentals", itemLink: "/rentals" },
  { itemText: "Inventory", itemLink: "/inventory" },
];
const footerSupport = [
  { itemText: "Our Brands", itemLink: "/our-brands" },
  { itemText: "Parts & Service", itemLink: "/parts-service" },
  { itemText: "Contact", itemLink: "/contact" },
];
const footerCompany = [
  { itemText: "Company", itemLink: "/company" },
  { itemText: "Employment", itemLink: "/employment" },
];
const footerLegal = [
  { itemText: "Legal", itemLink: "/legal" },
  { itemText: "Privacy", itemLink: "/privacy" },
  { itemText: "Terms", itemLink: "/terms" },
];
---

<div class="site-footer-wrap">
  <footer class="site-footer">
    <Container className="container--wide">
      <div class="footer-grid">
        <div class="footer-brand">
          <div>
            <a href="/">
              <span class="footer-brand-name">Southwest Sweeper Sales</span>
            </a>
            <p class="footer-tagline">Serving the Arizona Valley since 1975.</p>
          </div>
        </div>
        <GroupFooterNav>
          <FooterNav title="Company" navItems={footerCompany} />
          <FooterNav title="Solutions" navItems={footerNav1} />
        </GroupFooterNav>
        <GroupFooterNav>
          <FooterNav title="Support" navItems={footerSupport} />
          <FooterNav title="Resources" navItems={footerLegal} />
        </GroupFooterNav>
      </div>
    </Container>
    <div class="footer-bottom">
      <Container className="container--wide">
        <div class="footer-bottom-inner">
          <p>
            &copy; 1975 - <span id="year"></span>, Southwest Sweeper Sales. All
            rights reserved.
          </p>
          <p>
            Produced by <a
              href="https://toddl.dev"
              target="_blank"
              class="footer-nav">Todd Libby</a>
          </p>
        </div>
      </Container>
    </div>
  </footer>
</div>
<script>
  document.getElementById("year")!.textContent = new Date()
    .getFullYear()
    .toString();
</script>
